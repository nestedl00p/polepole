<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>001f595c-5bd2-4b98-9b8e-5e7fe4457c47</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Design-time only (dotnet ef ...). PrivateAssets keeps these and their
         MSBuild tooling dependencies out of the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Security pins. Both are transitive dependencies whose resolved versions
         carry known advisories. A direct reference wins over a transitive one, so
         these raise the floor without forking the parent packages. Drop a pin once
         its parent resolves to at least this version on its own.

         SQLitePCLRaw.bundle_e_sqlite3 - EntityFrameworkCore.Sqlite 10.0.0 resolved
           lib.e_sqlite3 2.1.11; GHSA-2m69-gcr7-jv3q (high) affects 2.1.11 and below.
           Held in the 2.1.x line: 3.x is a new major the EF Core 10 stack does not
           expect.

         System.Security.Cryptography.Pkcs - EntityFrameworkCore.Design/Tools
           resolved 9.0.0 through Microsoft.Build.Tasks.Core;
           GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate) are both
           patched in 10.0.13. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure the course content is always copied next to the built app. -->
    <None Update="Data\lessons.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
