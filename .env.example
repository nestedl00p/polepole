# ============================================================================
# PolePole — configuration & secrets reference
# ============================================================================
# This file lists every setting the app understands. It is a REFERENCE, not a
# file the app auto-loads. Do NOT put real keys here — copy this to a private
# location and fill it in there.
#
# The .NET backend reads config from, in order of precedence:
#   1. appsettings.json        (committed; placeholders only)
#   2. Environment variables    ( __  = nested section, e.g. Tts__Azure__Key )
#   3. user-secrets             (Development only — recommended for local dev)
#
# Local dev (keeps secrets out of git):
#   cd backend/SwahiliCourse.Api
#   dotnet user-secrets set "Tts:Azure:Key" "xxxxxxxx"
#
# Production: set these as real environment variables (double-underscore form).
# ----------------------------------------------------------------------------


# ---- Auth (REQUIRED before any real deployment) ----------------------------
# 32+ char random string. appsettings.json ships with a placeholder — override it.
Jwt__Key=change-this-to-a-long-random-secret-at-least-32-characters
Jwt__Issuer=SwahiliCourse


# ---- Database --------------------------------------------------------------
# Default is a local SQLite file. Swap for Postgres/SQL Server in Program.cs.
ConnectionStrings__Default=Data Source=swahili.db


# ---- Frontend hosting / CORS (only when the frontend is hosted separately) ---
# The default deploy serves the React app from the API's wwwroot, so it is
# same-origin and neither of these is needed. Set both when the frontend lives
# somewhere else (e.g. a static site on Vercel) — see deploy/VERCEL.md.
#
# API side: which browser origins may call the API. Comma-separated; an entry may
# use a "*." wildcard (https://*.vercel.app) to match preview subdomains, at the
# cost of allowing any site on that domain. Defaults to the Vite dev server.
Cors__AllowedOrigins=http://localhost:5173,http://localhost:3000

# Frontend side: the API's origin, read by Vite at BUILD time and inlined into
# the bundle, so it is set in the hosting provider's build env (not here) and a
# change needs a rebuild. Empty/unset = same origin.
VITE_API_BASE=


# ---- Cloud Text-to-Speech (OPTIONAL) ---------------------------------------
# Leave Provider=None to use the built-in browser/device voice (no key needed).
# Provider: None | Azure | Google | Knowlez | Mock
Tts__Provider=None
Tts__Voice=sw-KE-ZuriNeural
Tts__Rate=0.85

# Azure Speech (Provider=Azure)
Tts__Azure__Key=
Tts__Azure__Region=eastus

# Google Cloud TTS (Provider=Google)
Tts__Google__ApiKey=

# Knowlez TTS (Provider=Knowlez)
Tts__Knowlez__ApiKey=
Tts__Knowlez__Endpoint=https://api-tts.knowlez.com/v1/tts/synthesise
Tts__Knowlez__LanguageCode=

# Startup warm-up: pre-generate & cache all lesson audio (off by default)
Tts__Warmup__Enabled=false
Tts__Warmup__DelayMs=1100


# ---- Speak-and-check pronunciation (OPTIONAL) ------------------------------
# Requires the whisper-service sidecar to be running. Off by default.
Speech__Enabled=false
Speech__WhisperUrl=http://127.0.0.1:8081
Speech__Language=sw


# ---- Whisper sidecar (whisper-service/app.py) ------------------------------
# These are read by the Python service's environment, not the .NET backend.
# Model: tiny | base | small | medium | large-v3   (small is the practical min for Swahili)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu          # cpu | cuda
WHISPER_COMPUTE=int8        # int8 | int8_float16 | float16 | float32
