# Normalize line endings: store as LF in the repo, check out native on each OS.
* text=auto

# Shell scripts are run by bash even on Windows (Git Bash), which rejects CRLF:
# "set -euo pipefail\r" fails with "invalid option name". Always check out LF.
*.sh text eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.mp3 binary
*.wav binary
