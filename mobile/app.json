{
  "expo": {
    "name": "PolePole",
    "slug": "polepole",
    "scheme": "polepole",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbf6ec",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polepole.app"
    },
    "android": {
      "package": "com.polepole.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "71833e02-5ec5-40cc-8384-b515dc1dbcd8"
      }
    },
    "owner": "nestedl00p"
  }
}
